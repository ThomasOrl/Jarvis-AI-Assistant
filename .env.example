# Copiez ce fichier en « .env » et remplissez les valeurs.

# ---- Conversation (obligatoire) ----
# Google Gemini : gratuit, cle sur https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=AIza...
AI_MODEL=gemini-3.6-flash

# Autres possibilites (memes 3 lignes) :
# Groq      -> https://api.groq.com/openai/v1            modele : llama-3.3-70b-versatile
# OpenRouter-> https://openrouter.ai/api/v1              modele : deepseek/deepseek-chat
# Ollama    -> http://localhost:11434/v1                 modele : llama3.2   (AI_API_KEY=ollama)
# OpenAI    -> https://api.openai.com/v1                 modele : gpt-4o-mini

# ---- Voix et dictee (optionnel, payant) ----
# Sans ces lignes, la lecture a voix haute utilise la voix du navigateur (gratuite)
# et le bouton micro est desactive.
# VOICE_API_KEY=sk-...
# VOICE_BASE_URL=https://api.openai.com/v1
# VOICE_MODEL=gpt-4o-mini-tts
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
